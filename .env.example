# App Configuration
APP_NAME="Python FastAPI E-Learning LMS & CBT"
APP_ENV=development
DEBUG=True
PORT=8000

# Database (PostgreSQL)
POSTGRES_DB=elearning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Async Database URI
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/elearning
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5434/elearning

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Security & JWT
SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
STORAGE_DRIVER=local
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=50

# MinIO (Optional S3)
MINIO_ENDPOINT=localhost:9002
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=elearning-media

# Frontend
FRONTEND_PORT=3001
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
